rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Event thumbnails
    match /event-thumbnails/{filename} {
      // Anyone can read thumbnails
      allow read: if true;
      
      // Only authenticated users can upload thumbnails
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 && // Max 5MB
        request.resource.contentType.matches('image/.*');
    }
    
    // User avatars (if needed in future)
    match /user-avatars/{userId}/{filename} {
      // Anyone can read avatars
      allow read: if true;
      
      // Only the user can upload their avatar
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 && // Max 2MB
        request.resource.contentType.matches('image/.*');
    }
    
    // Stream recordings (if needed in future)
    match /recordings/{eventId}/{filename} {
      // Only event owner and admins can read recordings
      allow read: if request.auth != null &&
        (request.auth.uid == eventId ||
         get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only event owner can upload recordings
      allow write: if request.auth != null &&
        request.auth.uid == eventId &&
        request.resource.size < 1024 * 1024 * 1024; // Max 1GB
    }
  }
}
